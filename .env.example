# Copie para .env e ajuste os valores.
# Em produção, defina uma API_KEY longa e aleatória.
API_KEY=
# CORS_ORIGINS=https://localhost,http://localhost:5000
# DATABASE_URL=postgresql+psycopg://ep:name:password@db-name.us-east-2.aws.neon.tech/db-name
# DATABASE_URL=sqlite:////home/usuario/treinolog/instance/treinolog.db (desenvolvimento local)
#
# No Render + Neon: use a Connection String do PostgreSQL.
# Exemplo: DATABASE_URL=postgresql+psycopg://ep-costalink-dev:npg_123456789@db-costalink-dev.do.corp.neon.tech/db-costalink-dev