# Copie para .env e ajuste os valores.
# Em produção, defina uma API_KEY longa e aleatória.
API_KEY=
# CORS_ORIGINS=https://localhost,capacitor://localhost
# DATABASE_URL=sqlite:////home/usuario/treinolog/instance/treinolog.db
#
# No Railway, basta anexar um volume montado em /data.
# A aplicação detecta RAILWAY_VOLUME_MOUNT_PATH e usa /data/treinolog.db.
# Só defina DATABASE_URL se quiser apontar para outro caminho/banco.
